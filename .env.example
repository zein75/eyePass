# PostgreSQL
POSTGRES_USER=eyepass
POSTGRES_PASSWORD=secret
POSTGRES_DB=eyepass_db
DATABASE_URL=postgresql://eyepass:secret@postgres:5432/eyepass_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Face Service
FACE_SERVICE_URL=http://face_service:8001
FACE_SIMILARITY_THRESHOLD=0.40
FACE_MIN_DETECTION_CONFIDENCE=0.85

# Camera
FRAME_INTERVAL_MS=500
SNAPSHOT_DIR=/data/snapshots

# Webhooks
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=3

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
